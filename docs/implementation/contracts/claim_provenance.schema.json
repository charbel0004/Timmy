{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed claim — draft v1",
  "type": "object", "additionalProperties": false,
  "required": ["claim_id", "run_id", "verdict", "statement_redacted", "kg_release_id", "source_refs", "rule_check_receipt_ids"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["verified", "blocked", "unverified", "proposed"]},
    "statement_redacted": {"type": "string", "minLength": 1, "maxLength": 1500},
    "kg_release_id": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "sha256"], "properties": {"source_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "row_refs": {"type": "array", "items": {"type": "string"}}}}},
    "rule_check_receipt_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tool_receipt_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policy_version_id": {"type": ["string", "null"]},
    "unsupported_reason": {"type": ["string", "null"]}
  }
}
