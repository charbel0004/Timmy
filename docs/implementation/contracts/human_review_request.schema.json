{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human review interruption — draft v1",
  "type": "object", "additionalProperties": false,
  "required": ["review_id", "run_id", "step_receipt_id", "issue_code", "project_id", "evidence_fingerprint", "allowed_decisions", "required_permission", "version", "status", "created_at"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "step_receipt_id": {"type": "string", "minLength": 1},
    "issue_code": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowed_decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CONFIRM_MAPPING", "CORRECT_MAPPING", "INVALIDATE_CLAIM", "AUTHORIZE_PLANNING_EXCEPTION", "AUTHORIZE_GROUP", "DECLINE_GROUP", "REQUEST_INFORMATION"]}},
    "required_permission": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["OPEN", "RESOLVED", "CANCELLED", "SUPERSEDED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "resolved_by": {"type": ["string", "null"]},
    "resolution_code": {"type": ["string", "null"]},
    "human_note": {"type": ["string", "null"], "maxLength": 2000},
    "target_credit_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "allocation_minor_units": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["project_id", "amount_cents"], "properties": {"project_id": {"type": "string"}, "amount_cents": {"type": "integer", "minimum": 0}}}}
  }
}
