TIMMY_DATABASE_URL=sqlite:///./timmy.db
TIMMY_FRONTEND_ORIGIN=http://localhost:5173
TIMMY_COOKIE_SECURE=false
TIMMY_SESSION_HOURS=8
TIMMY_DEMO_MODE=false
TIMMY_OLLAMA_URL=http://127.0.0.1:11434
TIMMY_OLLAMA_MODEL=qwen3.5
TIMMY_OLLAMA_TIMEOUT_SECONDS=90
TIMMY_OLLAMA_CONNECT_TIMEOUT_SECONDS=5
TIMMY_OLLAMA_MAX_TOKENS=1024
TIMMY_OLLAMA_SEED=42
TIMMY_ACTIVATION_MINUTES=60
TIMMY_WHISPER_MODEL=small
TIMMY_WHISPER_DEVICE=cpu
TIMMY_WHISPER_COMPUTE_TYPE=int8
TIMMY_WHISPER_CACHE=~/.cache/timmy/whisper
TIMMY_PIPER_MODEL=~/.cache/timmy/voices/en_US-lessac-medium.onnx
TIMMY_PIPER_SPEED=1.0
# Set only after the source contract and project timezone are approved.
# TIMMY_REPORT_SOURCE=
# TIMMY_REPORT_TIMEZONE=
